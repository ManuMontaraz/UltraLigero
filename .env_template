# Branding
APP_NAME=LeafPack
APP_URL=http://localhost:3000

# Frontend branding (Vite variables - must start with VITE_)
VITE_APP_NAME=LeafPack
VITE_APP_URL=http://localhost:5173
VITE_AUTHOR_NAME="Tu Nombre"
VITE_AUTHOR_EMAIL="tu@email.com"
VITE_AUTHOR_WEB="https://tuweb.com"
VITE_GITHUB_URL="https://github.com/tuusuario/turepo"

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_contraseña_db
DB_NAME=ultraligero
DB_PORT=3306

# CORS
# Orígenes permitidos (separados por coma para múltiples)
# Ejemplo: https://tuweb.com,https://otraweb.com
# En desarrollo puedes dejarlo vacío para permitir cualquier origen
CORS_ORIGIN=

# Server
PORT=3000
NODE_ENV=development

# Puppeteer / OG image generation
# Ruta al ejecutable de Chromium en el servidor
# En desarrollo puedes dejarlo vacío si Puppeteer descarga Chrome automáticamente
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Admin - Cambia esta contraseña en producción
ADMIN_PASSWORD=contraseña_segura_admin

# Referidos - Tu código de afiliado se añade automáticamente a URLs
AFFILIATE_TAG=ref=tu-codigo

# Uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=4194304
